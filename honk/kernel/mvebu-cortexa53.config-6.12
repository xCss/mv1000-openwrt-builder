# Extra kernel options for the universal mvebu/cortexa53 (MV1000) firmware.
# Matching CONFIG_KERNEL_* options in honk.yml must also be enabled: OpenWrt
# applies those after this fragment and can override cgroups, BTF and tracing.
# Loadable network modules are selected as kmod packages in honk.yml so their
# files and APK dependencies enter the image.
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_NETKIT=y

# honk UDP receive tracing uses BPF FEntry/FExit, gated by BPF_EVENTS.
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_BPF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
