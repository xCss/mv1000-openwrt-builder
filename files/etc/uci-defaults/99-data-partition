#!/bin/sh
# mv1000-data-partition: create an ext4 data partition in the unused tail
# of the eMMC on first boot, then make sure it is mounted at /mnt/data.

DEV=/dev/mmcblk1
THRESHOLD=1048576   # 512 MiB of free space required

[ -b "$DEV" ] || exit 0
command -v parted >/dev/null 2>&1 || exit 0

ensure_mount() {
	mkdir -p /mnt/data
	uuid=$(block info "${DEV}p3" 2>/dev/null | sed -n 's/.*UUID="\([^"]*\)".*/\1/p')
	if [ -z "$uuid" ] || [ ! -f /etc/config/fstab ]; then
		mount "${DEV}p3" /mnt/data
		return
	fi
	cfg=$(uci -q show fstab | sed -n "s/^fstab\.\(cfg[0-9a-f]*\)\.target='\/mnt\/data'$/\1/p" | head -n1)
	[ -n "$cfg" ] || cfg=$(uci add fstab mount)
	# values must be unquoted: this uci stores quotes literally
	uci set "fstab.$cfg.target=/mnt/data"
	uci set "fstab.$cfg.uuid=$uuid"
	uci set "fstab.$cfg.enabled=1"
	uci set "fstab.$cfg.options=rw,noatime"
	uci commit fstab
	/etc/init.d/fstab enable
	/sbin/block mount
	grep -qs ' /mnt/data ' /proc/mounts || mount "${DEV}p3" /mnt/data
}

if [ ! -b "${DEV}p3" ]; then
	out=$(parted -s "$DEV" unit s print 2>/dev/null) || exit 0

	disk_sectors=$(echo "$out" | awk '/^Disk \/dev\/mmcblk1:/ {gsub("s","",$3); print $3}')
	last_end=$(echo "$out" | awk '$1 ~ /^[0-9]+$/ {e=$3; gsub("s","",e); if (e+0 > m) m=e+0} END {print m}')

	[ -n "$disk_sectors" ] && [ -n "$last_end" ] || exit 0
	[ $((disk_sectors - last_end)) -ge $THRESHOLD ] || exit 0

	start=$(( (last_end + 1 + 2047) / 2048 * 2048 ))

	# parted rewrites the MBR disk signature, which root=PARTUUID depends on.
	dd if="$DEV" of=/tmp/mbr.bak bs=512 count=1 2>/dev/null
	parted -s "$DEV" unit s mkpart primary ext4 "$start" 100%
	rc=$?
	dd if=/tmp/mbr.bak of="$DEV" bs=1 skip=440 seek=440 count=4 conv=notrunc 2>/dev/null
	sync
	[ $rc -eq 0 ] || exit 1
	sleep 1
	[ -b "${DEV}p3" ] || exit 1

	mkfs.ext4 -F -L data -m 1 "${DEV}p3" || exit 1
fi

ensure_mount
grep -qs ' /mnt/data ' /proc/mounts || exit 1

exit 0
