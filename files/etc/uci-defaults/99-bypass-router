#!/bin/sh
# First-boot defaults for MV1000 acting as a bypass router behind XDR5480.
# Runs once; the file removes itself after a successful run.

[ -s /etc/config/network ] || /bin/config_generate
[ -s /etc/config/network ] || exit 0

uci -q batch <<'EOF'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.2'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='192.168.1.4'
set network.lan.broadcast='192.168.1.255'
set network.lan.mtu='1492'
set network.lan.ipv6='0'
delete network.lan.ip6assign
delete network.lan.ip6hint
delete network.lan.dns
add_list network.lan.dns='192.168.1.4'

delete network.wan
delete network.wan6

set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
set dhcp.lan.ra_slaac='0'

set firewall.@zone[0].input='ACCEPT'
set firewall.@zone[0].output='ACCEPT'
set firewall.@zone[0].forward='ACCEPT'
set firewall.@zone[0].masq='1'
set firewall.@zone[0].mtu_fix='1'

set system.@system[0].hostname='mv1000'
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'

commit
EOF

exit 0
