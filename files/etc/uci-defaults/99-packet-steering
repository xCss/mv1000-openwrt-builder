#!/bin/sh

[ -x /etc/init.d/packet_steering ] || exit 0
uci -q get 'network.@globals[0].packet_steering' >/dev/null && exit 0

cpu_count="$(grep -c '^cpu[0-9][0-9]*[[:space:]]' /proc/stat)" || exit 1
[ "$cpu_count" -gt 1 ] || exit 0

if ! uci -q get 'network.@globals[0]' >/dev/null; then
	uci set network.globals=globals || exit 1
fi
uci set 'network.@globals[0].packet_steering=2' || exit 1
uci commit network || exit 1
/etc/init.d/packet_steering enable || exit 1
/etc/init.d/packet_steering reload
